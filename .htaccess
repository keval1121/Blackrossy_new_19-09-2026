
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # One canonical host: https://blackrossy.com (no www).
    RewriteCond %{HTTP_HOST} ^www\.blackrossy\.com$ [NC]
    RewriteRule ^ https://blackrossy.com%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Hostinger document root = project root (not /public).
    # Map asset URLs without needing public/storage symlink (exec/symlink often disabled).
    # Guard against rewrite loops: /storage → storage/app/public → must not rematch ^storage/.
    RewriteRule ^build/(.*)$ public/build/$1 [L,NC]
    RewriteRule ^storage/app/public/(.*)$ - [L]
    RewriteRule ^storage/(.*)$ storage/app/public/$1 [L,NC]
    RewriteRule ^images/(.*)$ public/images/$1 [L,NC]
    RewriteRule ^favicon\.ico$ public/favicon.ico [L,NC]
    RewriteRule ^robots\.txt$ public/robots.txt [L,NC]

    # Redirect Trailing Slashes If Not A Folder
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Laravel Front Controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
